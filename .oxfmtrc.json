{
    "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/refs/heads/main/npm/oxfmt/configuration_schema.json",
    "useTabs": false,
    "singleQuote": false,
    "tabWidth": 4,
    "trailingComma": "all",
    "printWidth": 115,
    "sortPackageJson": false,
    "ignorePatterns": ["package-lock.json", "pnpm-lock.yaml", "yarn.lock", ".gitlab-ci.yml"],
    "svelte": true
}
